---
import Button from "../components/Button.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found">
  <div class="min-h-[calc(100vh-var(--ui-header-height))] flex flex-col items-center justify-center text-center py-24">
    <p class="text-base font-semibold text-primary">404</p>
    <h1 class="text-4xl sm:text-5xl font-bold text-highlighted text-balance mt-2">Page not found</h1>
    <p class="mt-4 text-lg text-muted text-balance">It looks like the page you are looking for doesn't exist.</p>
    <div class="mt-8">
      <Button href="/" label="Back to home" icon="lucide:arrow-left" size="lg" />
    </div>
  </div>
</Layout>
