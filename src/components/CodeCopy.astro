---
import { Icon } from "astro-icon/components";
---

<template id="code-copy-button">
  <button
    type="button"
    aria-label="Copy code to clipboard"
    class="group/copy absolute top-2.5 end-2.5 p-1.5 text-muted bg-muted border border-muted hover:text-highlighted opacity-0 group-hover:opacity-100 focus-visible:opacity-100 transition cursor-pointer"
  >
    <Icon name="lucide:copy" class="size-4 group-data-copied/copy:hidden" aria-hidden="true" />
    <Icon name="lucide:copy-check" class="size-4 hidden group-data-copied/copy:block" aria-hidden="true" />
  </button>
</template>

<script>
  const template = document.querySelector<HTMLTemplateElement>("#code-copy-button");

  document.querySelectorAll<HTMLPreElement>(".prose pre").forEach((pre) => {
    if (!template) return;
    const wrapper = document.createElement("div");
    wrapper.className = "relative group";
    pre.replaceWith(wrapper);
    wrapper.append(pre);

    const button = template.content.firstElementChild!.cloneNode(true) as HTMLButtonElement;
    button.addEventListener("click", async () => {
      await navigator.clipboard.writeText(pre.innerText);
      button.dataset.copied = "";
      setTimeout(() => delete button.dataset.copied, 2000);
    });
    wrapper.append(button);
  });
</script>
