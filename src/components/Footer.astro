---
import Button from "./Button.astro";
import Logo from "./Logo.astro";
import { getProfile } from "../lib/content";

const profile = await getProfile();

const socials = [
  profile.github && { icon: "simple-icons:github", href: profile.github, label: "GitHub" },
  profile.twitter && { icon: "simple-icons:x", href: profile.twitter, label: "X" },
  profile.linkedin && { icon: "simple-icons:linkedin", href: profile.linkedin, label: "LinkedIn" },
  { icon: "hugeicons:mail-01", href: `mailto:${profile.email}`, label: "Email" },
].filter((s) => !!s);
---

<footer class="bg-default border-t border-default">
  <div class="relative max-w-(--ui-container) mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex flex-col md:flex-row justify-between gap-10">
      <div class="flex gap-8 items-center">
        <Logo class="size-20 shrink-0" />
        <p class="text-muted text-sm max-w-xs leading-relaxed">{profile.bio}</p>
      </div>

      <div class="flex flex-col gap-2">
        <span class="text-toned uppercase text-sm font-medium tracking-widest">Contact</span>
        <div class="flex gap-2">
          {socials.map((s) => (
            <Button
              href={s.href}
              icon={s.icon}
              ariaLabel={s.label}
              variant="neutral"
              external={!s.href.startsWith("mailto:")}
            />
          ))}
        </div>
      </div>
    </div>

    <div class="flex flex-col sm:flex-row justify-between items-center gap-2 text-muted text-sm mt-8 md:mt-16">
      <span>
        ©{new Date().getFullYear()} {profile.name}
      </span>
      <span>Designed & built by {profile.name}</span>
    </div>
  </div>
</footer>
